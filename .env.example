# Credenciais server-side da API oficial Higgsfield
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# Acesso privado ao Studio (use valores longos e exclusivos)
HIGGSFIELD_STUDIO_PASSWORD=
HIGGSFIELD_STUDIO_SESSION_SECRET=

# Opcional: origem pública exata, usada para validar requisições mutáveis
# Exemplo: https://azevedoacademy.com.br
HIGGSFIELD_STUDIO_ORIGIN=

---
interface Props { src?: string; texto: string; play?: boolean; eager?: boolean }
const { src, texto, play = false, eager = false } = Astro.props;
---
<div class:list={['capa', { 'capa--gerada': !src }]}>
  {src ? <img src={src} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" /> : <span>{texto}</span>}
  {play && <span class="capa__play" aria-hidden="true"></span>}
</div>

---
import type { CollectionEntry } from 'astro:content';
import Capa from './Capa.astro';
import { formatarData, thumbYoutube } from '../lib/util';
interface Props { m: CollectionEntry<'materiais'> }
const { m } = Astro.props;
const { titulo, resumo, data, capa, youtube, ferramentas, prompts, arquivos } = m.data;
const busca = [titulo, resumo, ...ferramentas].join(' ').toLowerCase();
const extras = [
  prompts.length ? `${prompts.length} ${prompts.length === 1 ? 'prompt' : 'prompts'}` : '',
  arquivos.length ? `${arquivos.length} ${arquivos.length === 1 ? 'arquivo' : 'arquivos'}` : '',
].filter(Boolean);
---
<article class="cartao" data-busca={busca}>
  <Capa src={capa ?? thumbYoutube(youtube)} texto={ferramentas[0] ?? 'Tutorial'} play={!!youtube} />
  <div class="cartao__texto">
    <div class="meta"><time datetime={data.toISOString()}>{formatarData(data)}</time>{extras.map((e) => <span>{e}</span>)}</div>
    <h3><a class="alvo" href={`/materiais/${m.id}`}>{titulo}</a></h3>
    <p>{resumo}</p>
    {ferramentas.length > 0 && <div class="ferramentas">{ferramentas.map((f) => <span>{f}</span>)}</div>}
  </div>
</article>

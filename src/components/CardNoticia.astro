---
import type { CollectionEntry } from 'astro:content';
import Capa from './Capa.astro';
import { formatarData } from '../lib/util';
interface Props { n: CollectionEntry<'noticias'> }
const { n } = Astro.props;
const { titulo, resumo, data, categoria, capa } = n.data;
---
<article class="cartao" data-categoria={categoria}>
  <Capa src={capa} texto={categoria} />
  <div class="cartao__texto">
    <div class="meta"><span class="cat">{categoria}</span><time datetime={data.toISOString()}>{formatarData(data)}</time></div>
    <h3><a class="alvo" href={`/noticias/${n.id}`}>{titulo}</a></h3>
    <p>{resumo}</p>
  </div>
</article>

---
import '@fontsource/geist/latin-400.css';
import '@fontsource/geist/latin-500.css';
import '@fontsource/geist/latin-600.css';
import '@fontsource/geist/latin-700.css';
import '../styles/site.css';
import { SITE, ADSENSE } from '../lib/util';

interface Props {
  titulo?: string;
  descricao?: string;
  imagem?: string;
  imagemAlt?: string;
  tipo?: 'website' | 'article';
  publicado?: Date;
  atualizado?: Date;
  secao?: string;
  tags?: string[];
  jsonld?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  titulo, descricao = SITE.descricao, imagem, imagemAlt, tipo = 'website',
  publicado, atualizado, secao, tags = [], jsonld = [], noindex = false,
} = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${SITE.nome}` : `${SITE.nome} | Notícias de IA e materiais dos tutoriais`;
const canonical = new URL(Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, ''), Astro.site);
const ogPadrao = !imagem;
const og = new URL(imagem ?? '/og-padrao.png', Astro.site);
const verificacao = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION as string | undefined;
const path = Astro.url.pathname;

const nav = [
  { href: '/noticias', label: 'Notícias' },
  { href: '/materiais', label: 'Materiais' },
  { href: '/biblioteca-de-prompts', label: 'Biblioteca de prompts' },
  { href: '/influencer-com-ia', label: 'Curso' },
];
const ativo = (href: string) => path === href || path.startsWith(href.replace(/\/$/, '') + '/');
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="author" content={SITE.autor} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:title" content={titulo ?? tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    {ogPadrao && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>}
    {imagemAlt && <meta property="og:image:alt" content={imagemAlt} />}
    {publicado && <meta property="article:published_time" content={publicado.toISOString()} />}
    {(atualizado ?? publicado) && <meta property="article:modified_time" content={(atualizado ?? publicado)!.toISOString()} />}
    {secao && <meta property="article:section" content={secao} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo ?? tituloCompleto} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={og} />
    <link rel="alternate" type="application/rss+xml" title="Notícias de IA | Azevedo Academy" href="/noticias/rss.xml" />
    {verificacao && <meta name="google-site-verification" content={verificacao} />}
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
    {ADSENSE && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE}`} crossorigin="anonymous"></script>}
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>

    <header class="topo" data-topo>
      <div class="topo__inner">
        <a class="marca" href="/" aria-label="Azevedo Academy, página inicial">
          <img src="/assets/images/azevedo-logo-original.svg" alt="" width="26" height="27" />
          <span>Azevedo Academy</span>
        </a>

        <nav class="nav" id="nav" aria-label="Principal" data-nav>
          {nav.map((n) => <a href={n.href} aria-current={ativo(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>

        <div class="topo__acoes">
          <div class="conta" data-conta data-modo="entrar">
            <button class="conta__btn" type="button" aria-expanded="false" aria-controls="conta-painel" aria-haspopup="dialog" data-conta-btn>
              <span class="conta__icone" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8.5" r="3.5"/><path d="M5 19.5c1.4-3.2 4-4.8 7-4.8s5.6 1.6 7 4.8" stroke-linecap="round"/></svg>
              </span>
              <span data-conta-rotulo>Entrar</span>
              <svg class="conta__seta" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </button>

            <div class="conta__painel" id="conta-painel" role="dialog" aria-label="Sua conta" data-conta-painel>
              <div data-conta-deslogado>
                <p class="conta__titulo">Sua conta na Azevedo Academy</p>
                <p class="conta__sub">Entre para acompanhar as novidades e os materiais do canal.</p>
                <div class="segmento" role="tablist" aria-label="Escolha uma opção">
                  <span class="segmento__pilula" aria-hidden="true"></span>
                  <button type="button" role="tab" aria-selected="true" data-aba="entrar">Entrar</button>
                  <button type="button" role="tab" aria-selected="false" data-aba="criar">Criar conta</button>
                </div>
                <form class="conta__form" data-conta-form novalidate>
                  <label class="campo" data-so-criar hidden>
                    <span>Nome</span>
                    <input name="nome" type="text" autocomplete="name" />
                  </label>
                  <label class="campo">
                    <span>E-mail</span>
                    <input name="email" type="email" autocomplete="email" required />
                  </label>
                  <label class="campo">
                    <span>Senha</span>
                    <input name="senha" type="password" autocomplete="current-password" minlength="6" required />
                  </label>
                  <p class="conta__msg" role="status" aria-live="polite" data-conta-msg></p>
                  <button class="btn btn--preto btn--cheio" type="submit" data-conta-enviar>Entrar</button>
                </form>
              </div>
              <div class="conta__logado" data-conta-logado hidden>
                <span class="avatar" data-conta-inicial>A</span>
                <p class="conta__titulo" data-conta-nome>Sua conta</p>
                <p class="conta__sub" data-conta-email></p>
                <button class="btn btn--linha btn--cheio" type="button" data-conta-sair>Sair</button>
              </div>
            </div>
          </div>

          <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav" data-menu-btn>
            <span class="sr">Menu</span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="rodape">
      <div class="largura rodape__grade">
        <div class="rodape__marca">
          <img src="/assets/images/azevedo-logo-original.svg" alt="" width="22" height="23" />
          <span>Azevedo Academy</span>
        </div>
        <nav aria-label="Conteúdo">
          <p>Conteúdo</p>
          <a href="/noticias">Notícias</a>
          <a href="/materiais">Materiais dos tutoriais</a>
          <a href="/biblioteca-de-prompts">Biblioteca de prompts</a>
        </nav>
        <nav aria-label="Aprender">
          <p>Aprender</p>
          <a href="/influencer-com-ia">Curso Influencer com IA</a>
          <a href={SITE.youtube} target="_blank" rel="noopener">Canal no YouTube</a>
        </nav>
        <nav aria-label="Institucional">
          <p>Azevedo Academy</p>
          <a href="/sobre">Sobre</a>
          <a href="/privacidade">Política de privacidade</a>
          <a href="/noticias/rss.xml">Feed RSS</a>
        </nav>
      </div>
      <p class="largura rodape__copy">© {new Date().getFullYear()} Azevedo Academy. Inteligência artificial para quem cria.</p>
    </footer>

    <script>
      import { iniciarPontos } from '../scripts/pontos';
      import { iniciarConta } from '../scripts/conta';

      const canvas = document.querySelector<HTMLCanvasElement>('[data-pontos]');
      if (canvas) iniciarPontos(canvas);
      iniciarConta();

      // Seções que se montam ao rolar
      const reduzir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll<HTMLElement>('[data-revelar-filhos]').forEach((pai) => {
        Array.from(pai.children).forEach((f, i) => { (f as HTMLElement).style.setProperty('--i', String(Math.min(i, 8))); f.setAttribute('data-revelar', 'filho'); });
      });
      const alvos = document.querySelectorAll<HTMLElement>('[data-revelar]');
      if (reduzir || !('IntersectionObserver' in window)) alvos.forEach((a) => a.classList.add('visivel'));
      else {
        const obs = new IntersectionObserver((itens) => itens.forEach((it) => {
          if (it.isIntersecting) { it.target.classList.add('visivel'); obs.unobserve(it.target); }
        }), { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
        alvos.forEach((a) => obs.observe(a));
      }

      const topo = document.querySelector<HTMLElement>('[data-topo]');
      const onScroll = () => topo?.classList.toggle('is-rolado', window.scrollY > 4);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
      menuBtn?.addEventListener('click', () => {
        const aberto = menuBtn.getAttribute('aria-expanded') === 'true';
        menuBtn.setAttribute('aria-expanded', String(!aberto));
        document.body.classList.toggle('nav-aberta', !aberto);
      });

      // Copiar prompts
      document.addEventListener('click', async (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-copiar]');
        if (!b) return;
        const alvo = document.getElementById(b.dataset.copiar!);
        if (!alvo) return;
        try {
          await navigator.clipboard.writeText(alvo.innerText.trim());
          b.dataset.estado = 'ok';
          b.querySelector('span')!.textContent = 'Copiado';
          setTimeout(() => { delete b.dataset.estado; b.querySelector('span')!.textContent = 'Copiar'; }, 1800);
        } catch {
          const r = document.createRange(); r.selectNodeContents(alvo);
          const s = getSelection(); s?.removeAllRanges(); s?.addRange(r);
        }
      });
    </script>
  </body>
</html>

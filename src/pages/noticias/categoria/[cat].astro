---
import Base from '../../../layouts/Base.astro';
import CardNoticia from '../../../components/CardNoticia.astro';
import Anuncio from '../../../components/Anuncio.astro';
import { noticiasOrdenadas, slug } from '../../../lib/util';

export async function getStaticPaths() {
  const todas = await noticiasOrdenadas();
  const categorias = [...new Set(todas.map((n) => n.data.categoria))];
  return categorias.map((c) => ({ params: { cat: slug(c) }, props: { categoria: c, lista: todas.filter((n) => n.data.categoria === c) } }));
}

const { categoria, lista } = Astro.props;
const descricao = `Notícias de inteligência artificial na categoria ${categoria}: o que saiu de novo e o que muda na prática.`;
---
<Base titulo={`${categoria}: notícias de IA`} descricao={descricao} noindex={lista.length < 3}>
  <header class="cabeca-pagina largura" data-revelar>
    <nav class="trilha" aria-label="Você está em"><a href="/noticias">Notícias</a></nav>
    <h1>{categoria}</h1>
    <p>{lista.length} {lista.length === 1 ? 'notícia' : 'notícias'} nesta categoria.</p>
  </header>
  <section class="largura">
    <div class="grade" data-revelar-filhos>{lista.map((n) => <CardNoticia n={n} />)}</div>
    <Anuncio nome="lista" />
  </section>
</Base>

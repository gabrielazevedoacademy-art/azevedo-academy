---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CardNoticia from '../../components/CardNoticia.astro';
import { noticiasOrdenadas, formatarData } from '../../lib/util';

export async function getStaticPaths() {
  const todas = await noticiasOrdenadas();
  return todas.map((n) => ({ params: { id: n.id }, props: { n, todas } }));
}

const { n, todas } = Astro.props;
const { Content } = await render(n);
const { titulo, resumo, data, categoria, capa, fonte } = n.data;
const mais = todas.filter((x) => x.id !== n.id).slice(0, 3);
---
<Base titulo={titulo} descricao={resumo} imagem={capa} tipo="article">
  <article class="artigo">
    <header class="artigo-cabeca leitura" data-revelar>
      <a class="voltar" href="/noticias">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 3 5 8l5 5"/></svg>
        Notícias
      </a>
      <div class="meta"><span class="cat">{categoria}</span><time datetime={data.toISOString()}>{formatarData(data)}</time></div>
      <h1>{titulo}</h1>
      <p class="resumo">{resumo}</p>
      <div class="meta"><span>Por Gabriel Azevedo</span></div>
    </header>
    {capa && <figure class="artigo-capa" data-revelar="escala"><img src={capa} alt="" /></figure>}
    <div class="prosa leitura" data-revelar style="--i:1"><Content /></div>
    {fonte && <p class="fonte leitura">Fonte original: <a class="link" href={fonte.url} target="_blank" rel="noopener">{fonte.nome}</a></p>}
  </article>

  {mais.length > 0 && (
    <section class="secao">
      <div class="largura">
        <div class="secao__cabeca"><h2>Mais notícias</h2><a class="link" href="/noticias">Ver todas</a></div>
        <div class="grade" data-revelar-filhos>{mais.map((x) => <CardNoticia n={x} />)}</div>
      </div>
    </section>
  )}
</Base>

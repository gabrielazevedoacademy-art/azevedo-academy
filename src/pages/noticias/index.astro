---
import Base from '../../layouts/Base.astro';
import CardNoticia from '../../components/CardNoticia.astro';
import Anuncio from '../../components/Anuncio.astro';
import { noticiasOrdenadas, slug } from '../../lib/util';

const noticias = await noticiasOrdenadas();
const categorias = [...new Set(noticias.map((n) => n.data.categoria))];
---
<Base titulo="Notícias de IA" descricao="As principais notícias sobre inteligência artificial: lançamentos, ferramentas, mercado e dicas, explicadas de forma direta.">
  <header class="cabeca-pagina largura" data-revelar>
    <h1>Notícias</h1>
    <p>Lançamentos, ferramentas novas e o que muda na prática pra quem cria conteúdo com inteligência artificial.</p>
  </header>

  <section class="largura">
    {categorias.length > 1 && (
      <div class="barra" data-revelar style="--i:1">
        <nav class="chips" aria-label="Categorias">
          <a class="chip" href="/noticias" aria-current="page">Todas</a>
          {categorias.map((c) => <a class="chip" href={`/noticias/categoria/${slug(c)}`}>{c}</a>)}
        </nav>
      </div>
    )}
    {noticias.length > 0
      ? <div class="grade" data-grade data-revelar-filhos>{noticias.map((n) => <CardNoticia n={n} />)}</div>
      : <p class="vazio">Nenhuma notícia publicada ainda.</p>}
    <Anuncio nome="lista" />
  </section>

</Base>

---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página não encontrada">
  <section class="hero">
    <div class="largura">
      <h1><span class="linha">Essa página</span><span class="linha">não existe.</span></h1>
      <p>O link pode estar errado ou o conteúdo mudou de endereço.</p>
      <div class="hero__acoes">
        <a class="btn btn--preto" href="/">Ir para o início</a>
        <a class="btn btn--linha" href="/noticias">Ver notícias</a>
      </div>
    </div>
  </section>
</Base>

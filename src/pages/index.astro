---
import Base from '../layouts/Base.astro';
import CardMaterial from '../components/CardMaterial.astro';
import { materiaisOrdenados, SITE } from '../lib/util';

const materiais = await materiaisOrdenados();
const recentes = materiais.slice(0, 6);
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.nome, url: Astro.site!.href, inLanguage: 'pt-BR' },
  { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.nome, url: Astro.site!.href,
    logo: new URL(SITE.logo, Astro.site).href, sameAs: [SITE.youtube] },
];
---
<Base jsonld={jsonld}>
  <section class="hero hero--pontos">
    <canvas class="pontos" aria-hidden="true" data-pontos></canvas>
    <div class="largura">
      <h1>
        <span class="linha entra" style="--i:0">Inteligência</span>
        <span class="linha entra" style="--i:1">artificial,</span>
        <span class="linha entra" style="--i:2">sem enrolação.</span>
      </h1>
      <p class="entra" style="--i:3">Os prompts, arquivos e links de cada tutorial do canal, prontos pra você usar.</p>
      <div class="hero__acoes entra" style="--i:4">
        <a class="btn btn--preto" href="/materiais">Ver materiais</a>
        <a class="btn btn--linha" href={SITE.youtube} target="_blank" rel="noopener">Assistir no YouTube</a>
      </div>
    </div>
  </section>

  <section class="secao" id="materiais">
    <div class="largura">
      <div class="secao__cabeca" data-revelar>
        <div>
          <h2>Materiais dos tutoriais</h2>
          <p>Escolha o vídeo e copie o prompt, baixe os arquivos ou abra as ferramentas usadas.</p>
        </div>
        {materiais.length > recentes.length && <a class="link" href="/materiais">Ver todos os materiais</a>}
      </div>
      {recentes.length > 0
        ? <div class="grade" data-revelar-filhos>{recentes.map((m) => <CardMaterial m={m} />)}</div>
        : <p class="vazio">Os materiais dos tutoriais aparecem aqui em breve.</p>}
    </div>
  </section>

  <section class="secao">
    <div class="largura atalhos" data-revelar-filhos>
      <a class="atalho" href="/biblioteca-de-prompts">
        <h2>Biblioteca de prompts</h2>
        <p>A coleção completa de prompts organizada por ferramenta e por tipo de criação.</p>
        <span class="link">Abrir a biblioteca</span>
      </a>
      <a class="atalho" href={SITE.youtube} target="_blank" rel="noopener">
        <h2>Canal no YouTube</h2>
        <p>Os tutoriais completos, passo a passo, com as ferramentas de IA mais usadas por quem cria.</p>
        <span class="link">Ver os vídeos</span>
      </a>
    </div>
  </section>

  <section class="secao">
    <div class="largura">
      <div class="curso" data-revelar="escala">
        <div class="curso__texto">
          <h2>Crie sua influencer com IA</h2>
          <p>O curso completo pra criar uma influenciadora digital com inteligência artificial, do primeiro rosto ao conteúdo publicado.</p>
          <a class="btn" href="/influencer-com-ia">Conhecer o curso</a>
        </div>
        <div class="curso__img"><img src="/assets/images/influencer-com-ia/hero-influencer.webp" alt="" loading="lazy" decoding="async" /></div>
      </div>
    </div>
  </section>
</Base>

---
import Base from '../../layouts/Base.astro';
import CardMaterial from '../../components/CardMaterial.astro';
import { materiaisOrdenados } from '../../lib/util';

const materiais = await materiaisOrdenados();
---
<Base titulo="Materiais dos tutoriais" descricao="Prompts, arquivos e links usados nos tutoriais de IA do canal Azevedo Academy no YouTube.">
  <header class="cabecalho-pagina">
    <div class="container">
      <span class="eyebrow">Do YouTube</span>
      <h1 class="titulo-display">Materiais dos <em>tutoriais.</em></h1>
      <p>Tudo o que aparece nos vídeos: prompts prontos pra copiar, arquivos pra baixar e os links das ferramentas usadas.</p>
    </div>
  </header>

  <section class="container" style="padding-bottom: 64px">
    {materiais.length > 0 ? (
      <>
        <label class="busca">
          <span class="sr">Buscar materiais</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          <input type="search" placeholder="Buscar por vídeo ou ferramenta…" data-busca-input />
        </label>
        <div class="grade" data-grade>{materiais.map((m) => <CardMaterial m={m} />)}</div>
        <p class="vazio" hidden data-sem-resultado>Nenhum material encontrado pra essa busca.</p>
      </>
    ) : <p class="vazio">Os materiais dos tutoriais aparecem aqui em breve.</p>}
  </section>

  <script>
    const input = document.querySelector<HTMLInputElement>('[data-busca-input]');
    const vazio = document.querySelector<HTMLElement>('[data-sem-resultado]');
    input?.addEventListener('input', () => {
      const termo = input.value.trim().toLowerCase();
      let visiveis = 0;
      document.querySelectorAll<HTMLElement>('[data-grade] [data-busca]').forEach((card) => {
        const ok = !termo || card.dataset.busca!.includes(termo);
        card.hidden = !ok;
        if (ok) visiveis++;
      });
      if (vazio) vazio.hidden = visiveis > 0;
    });
  </script>
</Base>

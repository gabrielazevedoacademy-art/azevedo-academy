---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { materiaisOrdenados, formatarData, thumbYoutube } from '../../lib/util';

export async function getStaticPaths() {
  const todos = await materiaisOrdenados();
  return todos.map((m) => ({ params: { id: m.id }, props: { m } }));
}

const { m } = Astro.props;
const { Content } = await render(m);
const { titulo, resumo, data, youtube, capa, ferramentas, prompts, arquivos, links } = m.data;
const temCorpo = Boolean(m.body?.trim());
---
<Base titulo={titulo} descricao={resumo} imagem={capa ?? thumbYoutube(youtube)} tipo="article">
  <article class="artigo">
    <header class="artigo-cabeca leitura">
      <a class="voltar" href="/materiais">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 3 5 8l5 5"/></svg>
        Materiais
      </a>
      <div class="meta"><time datetime={data.toISOString()}>{formatarData(data)}</time>
        {youtube && <a class="link" href={`https://www.youtube.com/watch?v=${youtube}`} target="_blank" rel="noopener">Assistir no YouTube</a>}
      </div>
      <h1>{titulo}</h1>
      <p class="resumo">{resumo}</p>
    </header>

    <div class="leitura">
      {youtube && (
        <div class="video">
          <iframe src={`https://www.youtube-nocookie.com/embed/${youtube}`} title={titulo} loading="lazy"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
      )}

      {ferramentas.length > 0 && (
        <section class="bloco">
          <h2>Ferramentas usadas</h2>
          <div class="etiquetas">{ferramentas.map((f) => <span>{f}</span>)}</div>
        </section>
      )}

      {prompts.length > 0 && (
        <section class="bloco" id="prompts">
          <h2>Prompts <small>{prompts.length}</small></h2>
          {prompts.map((p, i) => (
            <div class="prompt">
              <div class="prompt__topo">
                <h3>{p.titulo}</h3>
                <button class="copiar" type="button" data-copiar={`prompt-${i}`} aria-label={`Copiar ${p.titulo}`}>
                  <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="5" width="9" height="9" rx="2"/><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"/></svg>
                  <span>Copiar</span>
                </button>
              </div>
              <pre id={`prompt-${i}`}>{p.texto.trim()}</pre>
            </div>
          ))}
        </section>
      )}

      {arquivos.length > 0 && (
        <section class="bloco">
          <h2>Arquivos</h2>
          <div class="recursos">
            {arquivos.map((a) => <a class="recurso" href={a.url} target="_blank" rel="noopener" download><span>{a.nome}</span><span>Baixar</span></a>)}
          </div>
        </section>
      )}

      {links.length > 0 && (
        <section class="bloco">
          <h2>Links</h2>
          <div class="recursos">
            {links.map((l) => <a class="recurso" href={l.url} target="_blank" rel="noopener"><span>{l.nome}</span><span>Abrir site</span></a>)}
          </div>
        </section>
      )}

      {temCorpo && (
        <section class="bloco">
          <h2>Passo a passo</h2>
          <div class="prosa"><Content /></div>
        </section>
      )}
    </div>
  </article>
</Base>
